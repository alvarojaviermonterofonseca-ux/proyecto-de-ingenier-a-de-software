# Gym Control Pro - configuración local del backend
#
# Copia este archivo y ajusta los valores:
#     Copy-Item backend\.env.example backend\.env
#
# backend/.env está excluido de Git. Las variables definidas en la terminal
# tienen prioridad sobre las de este archivo, así que puedes usar .env para lo
# estable y la terminal para pruebas puntuales.

# --- Django ---
# Clave secreta. Genera una con:
#     python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
# Obligatoria con DJANGO_DEBUG=false; si falta, la aplicación no arranca.
# DJANGO_SECRET_KEY=pega-aqui-tu-clave-generada
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,testserver

# --- Base de datos ---
# sqlite (por defecto) o mysql.
DB_ENGINE=sqlite
# Ruta del archivo SQLite. Obligatoria: sustituye la ruta de ejemplo por la de
# tu equipo (en Windows, usa la ruta absoluta entre comillas si tiene espacios).
DB_NAME=C:\ruta\a\tu\proyecto\base de datos\db.sqlite3

# Credenciales para DB_ENGINE=mysql
# DB_NAME=
# DB_USER=
# DB_PASSWORD=
# DB_HOST=
# DB_PORT=

# --- Archivos privados ---
# Carpeta de las fotos de registros de comida; nunca se publica en /media/.
# Por defecto: media/private en la raíz del proyecto.
# PRIVATE_MEDIA_ROOT=C:\proyectos\gym_control_pro\media\private
FOTO_REGISTRO_MAX_BYTES=5242880
FOTO_REGISTRO_MAX_DIMENSION=10000

# --- API ---
# Registros por página en los listados.
API_PAGE_SIZE=25
# Intentos de inicio de sesión permitidos por IP.
LOGIN_THROTTLE_RATE=10/min
# Horas de validez de cada sesión Bearer.
AUTH_TOKEN_TTL_HOURS=8

# --- CORS ---
# Con DJANGO_DEBUG=true y esta variable vacía se permite cualquier origen.
# En producción define DJANGO_DEBUG=false y la lista separada por comas.
# CORS_ALLOWED_ORIGINS=https://app.ejemplo.com,https://admin.ejemplo.com

# --- HTTPS en producción ---
# Actívalo cuando la app se sirva por HTTPS (directo o tras un proxy que
# envíe X-Forwarded-Proto). Fuerza redirección, cookies seguras y HSTS.
# DJANGO_SECURE_SSL_REDIRECT=true
# DJANGO_SECURE_HSTS_SECONDS=3600

# --- Correo ---
# En desarrollo los correos se imprimen en la consola. Fuera de DEBUG se usa
# SMTP por defecto; ajusta estas variables para tu servidor real.
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.ejemplo.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=true
# DEFAULT_FROM_EMAIL=no-reply@gymcontrol.local
