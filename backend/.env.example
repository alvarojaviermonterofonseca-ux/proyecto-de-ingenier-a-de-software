# Gym Control Pro - configuración local del backend
#
# Copia este archivo y ajusta los valores:
#     Copy-Item backend\.env.example backend\.env
#
# backend/.env está excluido de Git. Las variables definidas en la terminal
# tienen prioridad sobre las de este archivo, así que puedes usar .env para lo
# estable y la terminal para pruebas puntuales.

# --- Django ---
# Clave secreta. Genera una con:
#     python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
# Obligatoria en producción; sin ella se usa la clave insegura de desarrollo.
# DJANGO_SECRET_KEY=pega-aqui-tu-clave-generada
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,testserver

# --- Base de datos ---
# sqlite (por defecto) o mysql.
DB_ENGINE=sqlite
# Ruta del archivo SQLite. Si se omite se usa "base de datos/db.sqlite3" en la
# raíz del proyecto. Usa una ruta absoluta si ejecutas manage.py desde otra
# carpeta, por ejemplo: DB_NAME=C:\proyectos\gym_control_pro\base de datos\db.sqlite3
# DB_NAME=

# Credenciales para DB_ENGINE=mysql
# DB_NAME=gym_control_pro
# DB_USER=root
# DB_PASSWORD=
# DB_HOST=127.0.0.1
# DB_PORT=3306

# --- Archivos privados ---
# Carpeta de las fotos de registros de comida; nunca se publica en /media/.
# Por defecto: media/private en la raíz del proyecto.
# PRIVATE_MEDIA_ROOT=C:\proyectos\gym_control_pro\media\private
FOTO_REGISTRO_MAX_BYTES=5242880
FOTO_REGISTRO_MAX_DIMENSION=10000

# --- API ---
# Registros por página en los listados.
API_PAGE_SIZE=25
# Intentos de inicio de sesión permitidos por IP.
LOGIN_THROTTLE_RATE=10/min
# Horas de validez de cada sesión Bearer.
AUTH_TOKEN_TTL_HOURS=8

# --- CORS ---
# Con DJANGO_DEBUG=true y esta variable vacía se permite cualquier origen.
# En producción define DJANGO_DEBUG=false y la lista separada por comas.
# CORS_ALLOWED_ORIGINS=https://app.ejemplo.com,https://admin.ejemplo.com
